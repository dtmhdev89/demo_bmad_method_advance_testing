generator client {
  provider = "prisma-client-js"
}

generator db {
  provider = "go run github.com/steebchen/prisma-client-go"
  output   = "../../apps/api/db"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREE
  PRO
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String? // Hashed password (bcrypt) – null for OAuth users
  name            String?
  role            Role           @default(FREE)
  image           String?
  decks           Deck[]
  targetLanguages UserLanguage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// Target languages selected during registration
model UserLanguage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageCode String // ISO 639-1 code e.g. "ja", "ko", "fr"
  createdAt    DateTime @default(now())

  @@unique([userId, languageCode])
}

model Deck {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  cards       Card[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConceptNode {
  id             String       @id @default(cuid())
  meaningCentral String
  cards          Card[]
  definitions    Definition[]
  examples       Example[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Definition {
  id            String      @id @default(cuid())
  text          String
  languageCode  String // "ja", "ko", etc.
  conceptNodeId String
  conceptNode   ConceptNode @relation(fields: [conceptNodeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Example {
  id            String      @id @default(cuid())
  text          String
  languageCode  String // "ja", "ko", etc.
  conceptNodeId String
  conceptNode   ConceptNode @relation(fields: [conceptNodeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Card {
  id          String  @id @default(cuid())
  deckId      String
  deck        Deck    @relation(fields: [deckId], references: [id])
  term        String // Từ gốc (ví dụ: "Nihongo")
  translation String // Nghĩa (ví dụ: "Tiếng Nhật")
  mnemonic    String? // Câu chuyện ghi nhớ tạo bởi AI
  audioUrl    String? // URL audio phát âm

  conceptNodeId String?
  conceptNode   ConceptNode? @relation(fields: [conceptNodeId], references: [id])

  // SRS Fields
  interval   Int      @default(0)
  repetition Int      @default(0)
  easeFactor Float    @default(2.5)
  nextReview DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
